{
  "name": "cnv-plate-planner",
  "version": "0.1.0",
  "private": true,
  "description": "TaqMan CNV 96/384-well plate layout, reaction planning, and QuantStudio sample-list export tool",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 0.0.0.0",
    "test": "npm run test:unit && npm run build && node --test tests/static-build.test.mjs",
    "test:unit": "tsx --test tests/*.test.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "8.0.13"
  },
  "type": "module"
}
